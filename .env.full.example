# For docker-compose.full.yml (the whole stack on one machine). Copy to `.env.full`, fill in the required
# values and start it with:
#   docker compose --env-file .env.full -f docker-compose.full.yml up -d --build
# Compose reads this file twice: to fill in docker-compose.full.yml (hence --env-file) and as the app's
# environment, so any variable from .env.example can be added here too.

## Required

# Anyone with this code can create an account. Pick something hard to guess.
REGISTRATION_CODE=
# Password of the bundled Postgres. Letters and digits only (it goes into a URL): `openssl rand -hex 24`.
POSTGRES_PASSWORD=
# The key pair the app signs call tokens with; the bundled LiveKit is given the same pair.
# Generate them with `openssl rand -hex 8` (key) and `openssl rand -hex 32` (secret, at least 32 characters).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

## Address

# Where people open the app. Locally the defaults work as they are.
APP_URL=http://localhost:3000
# Where browsers reach LiveKit's signalling (the app's server reaches it over the compose network).
LIVEKIT_URL=ws://localhost:7880
# The address LiveKit gives browsers for media. 127.0.0.1 works for browsers on this machine only; on a
# server, put its public IP here and set LIVEKIT_RTC_BIND=0.0.0.0 so ports 7881/tcp and 7882/udp are published.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_RTC_BIND=127.0.0.1

## HTTPS (`--profile https`, Caddy with Let's Encrypt certificates)
# Both names must point at this machine. Then set APP_URL=https://<APP_DOMAIN> and
# LIVEKIT_URL=wss://<LIVEKIT_DOMAIN> above.
# APP_DOMAIN=linkord.example.com
# LIVEKIT_DOMAIN=livekit.example.com

## Email

# Codes for account recovery and two-step login go to the bundled mail sink, which prints them in its log
# (`docker compose --env-file .env.full -f docker-compose.full.yml logs mailsink`). To send real email, set
# RESEND_API_URL=https://api.resend.com, your Resend key and a sender on a domain verified there.
RESEND_API_URL=http://mailsink:8025
RESEND_API_KEY=mail-sink
RESEND_FROM_EMAIL=Linkord <noreply@localhost>

## Optional (see .env.example for what each does and for the rest)

LIVEKIT_ROOM_NAME=linkord-room
# BACKUP_KEEP=7
# BACKUP_INTERVAL_SECONDS=86400
# KLIPY_API_KEY=
# MAL_CLIENT_ID=
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=
