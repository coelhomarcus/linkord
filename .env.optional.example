# Copy the settings you need into .env and remove the leading "# ".
# See docs/INTEGRATIONS.md for service setup and docs/DEPLOY.md for operations.

## Email and push notifications

# Resend sends account and security emails.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Linkord <noreply@example.com>
# Override only for a development mail sink.
# RESEND_API_URL=http://localhost:8025

# Configure all three VAPID settings together. Reuse the keys across deployments.
# PUSH_VAPID_PUBLIC_KEY=
# PUSH_VAPID_PRIVATE_KEY=
# PUSH_VAPID_SUBJECT=mailto:admin@example.com

## Integrations

# KLIPY GIF picker.
# KLIPY_API_KEY=
# MyAnimeList Wall widget.
# MAL_CLIENT_ID=
# IGDB game search and Twitch Wall widgets share one Twitch app.
# IGDB_CLIENT_ID=
# IGDB_CLIENT_SECRET=
# Steam Wall widgets and SteamGridDB activity art.
# STEAM_WEB_API_KEY=
# STEAMGRIDDB_API_KEY=
# GitHub repository that publishes the Windows installer.
# DESKTOP_RELEASES_REPO=owner/repo
# Set to 0 to load third-party pictures from their original hosts.
# MEDIA_PROXY=1

## HTTP and proxy

# HOST_BIND=0.0.0.0
# PORT=3000
# Set to 0 to run only the backend. The backend Docker target already sets it.
# SERVE_WEB=0
# Enable only behind a trusted proxy. The Docker image enables it by default.
# TRUST_PROXY=1
# Number of trusted proxies appending to X-Forwarded-For.
# TRUSTED_PROXY_HOPS=1
# Additional browser origins, separated by commas.
# ALLOWED_ORIGINS=
# Set to 1 to try CSP changes in report-only mode.
# CSP_REPORT_ONLY=1

## PostgreSQL

# Enable TLS when required by the database.
# DATABASE_SSL=1
# Trust a private CA with PEM line breaks escaped as \n. Certificate verification stays enabled.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
# DATABASE_POOL_MAX=10
# Set to 0 to run migrations separately.
# MIGRATE_ON_BOOT=1

## Sessions

# SESSION_COOKIE=ss_session
# Separate admin site origin. Leave unset to disable its HTTP API.
# ADMIN_URL=https://admin.example.com
# SESSION_TTL_DAYS=30
# Set idle days to 0 to keep sessions until their normal expiry.
# SESSION_IDLE_DAYS=14
# auto follows the HTTPS scheme. Use 1 or 0 to force the setting.
# COOKIE_SECURE=auto

## LiveKit and reconnects

# Set when the backend reaches LiveKit through a different address than browsers.
# LIVEKIT_SERVER_URL=http://livekit:7880
# Use a different room prefix for each deployment sharing one LiveKit project.
# LIVEKIT_ROOM_NAME=linkord-room
# LIVEKIT_TOKEN_TTL_SECONDS=60
# Grace periods for dropped connections, calls, and calls after a backend restart.
# RECONNECT_GRACE_MS=30000
# CALL_RECONNECT_GRACE_MS=180000
# CALL_RESTORE_GRACE_MS=90000

## Storage and backups

# Local paths shown below. In Docker, use /app/uploads and /app/backups.
# UPLOAD_DIR=./uploads
# Exports are stored in UPLOAD_DIR/exports by default.
# EXPORT_DIR=./uploads/exports
# Largest attachment in bytes.
# MAX_ATTACHMENT_BYTES=536870912
# Development only. Fetch missing files from another instance using the same database.
# UPLOADS_REMOTE_URL=https://chat.example.com
# Set to 0 to have the scheduled cleanup delete orphaned files.
# ORPHAN_SWEEP_DRY_RUN=1

# Keep backups outside the uploads directory.
# BACKUP_DIR=./backups
# BACKUP_KEEP=7
# Set executable paths when the PostgreSQL tools are outside PATH.
# PG_DUMP_BIN=pg_dump
# PG_RESTORE_BIN=pg_restore

## Logs

# LOG_LEVEL=info
# LOG_FORMAT=json

## Limits

# MAX_PARTICIPANTS=500
# MAX_CONNECTIONS_PER_USER=4
# MAX_CONNECTIONS_PER_IP=20
# Socket.IO payload size in bytes.
# MAX_MSG_BYTES=65536
# REGISTRATIONS_PER_IP_PER_HOUR=5
# MAX_NEW_ACCOUNTS_PER_HOUR=30
# MAX_OWNED_SERVERS_PER_USER=20
# MAX_SERVER_MEMBERSHIPS_PER_USER=100
# MAX_SERVER_MEMBERS=100
# MAX_CHANNELS_PER_SERVER=50
# MAX_ROLES_PER_SERVER=25
# MAX_INVITES_PER_SERVER=50
# MAX_WEBHOOKS_PER_CHANNEL=10
# MAX_FRIENDS=500
# MAX_PENDING_OUTGOING_REQUESTS=50

## Data retention

# Whole days. Set a value to 0 to keep that kind of record indefinitely.
# AUDIT_RETENTION_DAYS=0
# DATA_REPAIRS_RETENTION_DAYS=0
# NOTIFICATION_READ_RETENTION_DAYS=30
# NOTIFICATION_UNREAD_RETENTION_DAYS=90
# OUTBOX_RETENTION_DAYS=7
# SERVER_AUDIT_RETENTION_DAYS=90
