{
  "name": "linkord",
  "version": "1.0.0",
  "description": "Self-hosted chat app with messaging, voice/video calls & screen sharing.",
  "type": "module",
  "main": "server/dist/index.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server/dist/index.js",
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --env-file-if-exists=.env --import tsx server/src/index.ts",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p server/tsconfig.json",
    "build:web": "npm run build --prefix web",
    "check": "npm run typecheck:server:tests && npm run lint --prefix web && npm test && npm run build",
    "check:dead-code": "knip",
    "test": "npm run test:server && npm run test:web",
    "test:server": "node --env-file-if-exists=.env.test --import tsx --test \"server/tests/**/*.test.ts\"",
    "test:server:coverage": "node --env-file-if-exists=.env.test --import tsx --experimental-test-coverage --test \"server/tests/**/*.test.ts\"",
    "test:web": "npm run test --prefix web",
    "test:e2e": "npm test --prefix e2e",
    "test:e2e:features": "npm run test:features --prefix e2e",
    "test:e2e:restart": "npm run test:restart --prefix e2e",
    "test:e2e:upgrade": "npm run test:upgrade --prefix e2e",
    "typecheck:server:tests": "tsc -p server/tsconfig.tests.json",
    "admin:grant": "node --env-file-if-exists=.env --import tsx server/src/scripts/adminRole.ts grant",
    "admin:revoke": "node --env-file-if-exists=.env --import tsx server/src/scripts/adminRole.ts revoke",
    "db:preflight": "node --env-file-if-exists=.env --import tsx server/src/scripts/legacyPreflight.ts",
    "db:repair": "node --env-file-if-exists=.env --import tsx server/src/scripts/legacyRepair.ts",
    "db:rehearse": "node --env-file-if-exists=.env --import tsx server/src/scripts/rehearseMigration.ts",
    "test:integration": "node --env-file-if-exists=.env --import tsx server/src/scripts/runIntegrationTests.ts",
    "db:generate": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env --import tsx server/src/db/migrate.ts",
    "db:seed": "NODE_ENV=development node --env-file-if-exists=.env --import tsx server/src/scripts/seedDev.ts",
    "db:studio": "node --env-file-if-exists=.env ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/static": "^10.1.3",
    "drizzle-orm": "^0.45.2",
    "emoji-regex": "^10.6.0",
    "fastify": "^5.12.8",
    "livekit-server-sdk": "^2.18.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "thumbhash": "^0.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.44.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "@livekit/protocol": "1.45.7"
  }
}
