{
  "name": "overcord",
  "version": "1.0.0",
  "description": "Self-hosted chat app with messaging, voice/video calls & screen sharing.",
  "type": "module",
  "main": "server/dist/index.js",
  "scripts": {
    "start": "bun --preload ./server/dist/config/loadLocalEnv.js server/dist/index.js",
    "dev": "bun --bun concurrently -k -n server,web -c blue,magenta \"bun run dev:server\" \"bun run dev:web\"",
    "dev:server": "bun --watch --preload ./server/src/config/loadLocalEnv.ts server/src/index.ts",
    "dev:admin": "bun run --cwd admin dev",
    "dev:web": "bun run --cwd web dev",
    "dev:desktop": "npm start --prefix desktop",
    "build": "bun run build:server && bun run build:web && bun run build:admin",
    "build:server": "bun --bun tsc -p server/tsconfig.json",
    "build:admin": "bun run --cwd admin build",
    "build:web": "bun run --cwd web build",
    "package:desktop": "npm run package --prefix desktop",
    "check": "bun run typecheck:server:tests && bun run --cwd web lint && bun run --cwd admin lint && bun run check:audit && bun run test && bun run build",
    "check:audit": "bun audit --prod --audit-level=high && bun audit --cwd web --prod --audit-level=high && bun audit --cwd admin --prod --audit-level=high",
    "check:dead-code": "bun --bun knip",
    "test": "bun run test:server && bun run test:web && bun run test:admin",
    "test:server": "bun test --env-file=.env.test --isolate --timeout=30000 --path-ignore-patterns '**/integration/**' server/tests",
    "test:server:coverage": "bun test --coverage --env-file=.env.test --isolate --timeout=30000 --path-ignore-patterns '**/integration/**' server/tests",
    "test:admin": "bun run --cwd admin test",
    "test:web": "bun run --cwd web test",
    "test:desktop": "npm test --prefix desktop",
    "test:e2e": "bun run --cwd e2e test",
    "test:e2e:features": "bun run --cwd e2e test:features",
    "test:e2e:restart": "bun run --cwd e2e test:restart",
    "test:e2e:upgrade": "bun run --cwd e2e test:upgrade",
    "typecheck:server:tests": "bun --bun tsc -p server/tsconfig.tests.json",
    "admin:grant": "bun --preload ./server/src/config/loadLocalEnv.ts server/src/scripts/adminRole.ts grant",
    "admin:revoke": "bun --preload ./server/src/config/loadLocalEnv.ts server/src/scripts/adminRole.ts revoke",
    "db:preflight": "bun --preload ./server/src/config/loadLocalEnv.ts server/src/scripts/legacyPreflight.ts",
    "db:repair": "bun --preload ./server/src/config/loadLocalEnv.ts server/src/scripts/legacyRepair.ts",
    "backup": "bun --preload ./server/src/config/loadLocalEnv.ts server/src/scripts/backup.ts",
    "restore": "bun --preload ./server/src/config/loadLocalEnv.ts server/src/scripts/restore.ts",
    "backup:rehearse": "bun --preload ./server/src/config/loadLocalEnv.ts server/src/scripts/rehearseBackup.ts",
    "db:rehearse": "bun --preload ./server/src/config/loadLocalEnv.ts server/src/scripts/rehearseMigration.ts",
    "test:integration": "bun --preload ./server/src/config/loadLocalEnv.ts server/src/scripts/runIntegrationTests.ts",
    "db:generate": "bun --preload ./server/src/config/loadLocalEnv.ts ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "bun --preload ./server/src/config/loadLocalEnv.ts server/src/db/migrate.ts",
    "db:seed": "NODE_ENV=development bun --preload ./server/src/config/loadLocalEnv.ts server/src/scripts/seedDev.ts",
    "db:studio": "bun --preload ./server/src/config/loadLocalEnv.ts ./node_modules/drizzle-kit/bin.cjs studio",
    "emoji:data": "bun web/scripts/buildEmojiData.mjs",
    "icons": "bun web/scripts/buildIcons.ts"
  },
  "engines": {
    "bun": "1.4.5"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/static": "^10.1.3",
    "drizzle-orm": "^0.45.2",
    "emoji-regex": "^10.6.0",
    "fastify": "^5.12.8",
    "htmlparser2": "^12.0.0",
    "livekit-server-sdk": "^2.18.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "thumbhash": "^0.1.1",
    "web-push": "^3.6.7",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.10",
    "knip": "^6.44.1",
    "typescript": "~6.0.2",
    "yauzl": "^3.4.0"
  },
  "overrides": {
    "@livekit/protocol": "1.45.7"
  }
}
