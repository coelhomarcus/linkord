# Copy to .env. These settings match the local setup in docs/DEVELOPMENT.md.
# For production, see docs/DEPLOY.md. For optional settings, see .env.optional.example.

APP_URL=http://localhost:5173
DATABASE_URL=postgres://overcord:overcord@localhost:5432/overcord

# Set a code to allow account registration.
REGISTRATION_CODE=

# Set all three LiveKit values to enable voice, video, and screen sharing.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
