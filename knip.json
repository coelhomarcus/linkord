{
  "workspaces": {
    ".": {
      "entry": [
        "server/src/config/loadLocalEnv.ts",
        "server/src/scripts/*.ts",
        "server/tests/**/*.test.ts",
        "server/tests/**/*.itest.ts"
      ],
      "project": [
        "server/src/**/*.ts",
        "server/tests/**/*.ts"
      ]
    },
    "web": {
      "ignoreDependencies": [
        "@svgr/plugin-jsx",
        "class-variance-authority",
        "clsx",
        "tailwind-merge"
      ],
      "entry": [
        "scripts/*.{ts,mjs}",
        "tests/**/*.test.ts",
        "tests/**/*.test.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "tests/**/*.{ts,tsx}"
      ]
    },
    "admin": {
      "ignoreDependencies": [
        "@base-ui/react",
        "class-variance-authority",
        "clsx",
        "react-icons",
        "tailwind-merge"
      ],
      "entry": [
        "tests/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "tests/**/*.{ts,tsx}"
      ]
    },
    "e2e": {
      "ignoreDependencies": [
        "livekit-client"
      ],
      "entry": [
        "specs/**/*.spec.ts"
      ],
      "project": [
        "**/*.ts"
      ]
    },
    "desktop": {
      "entry": [
        "src/main/index.ts",
        "src/preload/*.cts",
        "scripts/*.mjs",
        "electron-builder.config.cjs",
        "tests/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,cts}",
        "scripts/**/*.mjs",
        "tests/**/*.ts"
      ]
    }
  }
}
