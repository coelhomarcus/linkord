{
  "id": "/",
  "name": "Linkord",
  "short_name": "Linkord",
  "description": "Chat, chamadas de voz e vídeo e compartilhamento de tela em tempo real.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["social", "communication"],
  "launch_handler": { "client_mode": ["focus-existing", "auto"] },
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "video/*", "audio/*", "application/*", "text/*"] }]
    }
  },
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Conversas", "url": "/app/channels/@me", "icons": [{ "src": "/icons/shortcut-conversations-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Amigos", "url": "/app/friends", "icons": [{ "src": "/icons/shortcut-friends-96.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Notificações", "url": "/app/notifications", "icons": [{ "src": "/icons/shortcut-notifications-96.png", "sizes": "96x96", "type": "image/png" }] }
  ]
}
