{
  "name": "overcord-desktop",
  "productName": "Overcord",
  "version": "1.1.0",
  "description": "Overcord desktop app: an Electron window around the web app.",
  "author": "Overcord",
  "homepage": "https://github.com/coelhomarcus/overcord",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.2"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
