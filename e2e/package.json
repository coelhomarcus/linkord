{
  "name": "linkord-e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun --bun playwright test",
    "test:features": "bun --bun playwright test --project=features",
    "test:restart": "bun --bun playwright test --project=restart",
    "test:upgrade": "bun --bun playwright test --project=upgrade",
    "test:split": "E2E_SPLIT=1 bun --bun playwright test --project=split",
    "report": "bun --bun playwright show-report report",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "22.10.2",
    "livekit-client": "2.22.0",
    "typescript": "5.7.2"
  }
}
